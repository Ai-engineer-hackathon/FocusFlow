{
  "manifest_version": 3,
  "name": "FocusFlow",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["https://*/*"],
  "action": { "default_popup": "popup.html" },
  "side_panel": { "default_path": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["readability_shim.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
